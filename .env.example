NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

STUDIO_BARBER_BUSINESS_SLUG=studio-barber-8
STUDIO_BARBER_RESOURCE_SLUG=main
STUDIO_BARBER_ADMIN_PASSWORD=

# Server-only OpenAI configuration. Never prefix these variables with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional when the API key is scoped to more than one OpenAI project.
OPENAI_PROJECT_ID=
# Reserved for a future direct OpenAI Realtime/SIP integration.
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
VOICE_SIP_FORWARDING_NUMBER=

# Phone agent provider. VOICE_TOOL_SECRET must be random and at least 32 characters.
VOICE_TOOL_SECRET=
VOICE_PROVIDER_ASSISTANT_ID=
VOICE_PHONE_NUMBER=
# Optional human fallback used by the Telnyx prompt while the agent is paused.
VOICE_FALLBACK_NUMBER=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=

# Random bearer secret (at least 32 characters) shared only with n8n.
N8N_AUTOMATION_SECRET=

# Meta WhatsApp Cloud API
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Copy the active Graph API version shown by Meta API Setup, e.g. vXX.X.
META_GRAPH_API_VERSION=
# Cost per delivered service reply, in millionths of EUR. Keep 0 while Meta rates it free.
META_SERVICE_MESSAGE_COST_MICROEUR=0
